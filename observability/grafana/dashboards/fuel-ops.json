{
 "uid": "fuel-ops",
 "title": "Fuel Supply Operations",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Service level",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sim_service_level",
     "legendFormat": "service level"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "409s by code (rate)",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (code) (rate(allocation_conflicts_total[1m]))",
     "legendFormat": "{{code}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Simulator error rate",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(sim_requests_total{result!=\"ok\"}[1m])) / clamp_min(sum(rate(sim_requests_total[1m])), 1e-9)",
     "legendFormat": "error ratio"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "p95 latency",
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"backend\"}[1m])))",
     "legendFormat": "backend API p95"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(sim_request_seconds_bucket[1m])))",
     "legendFormat": "simulator calls p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Circuit breaker (0 closed, 1 half-open, 2 open)",
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sim_circuit_breaker_state",
     "legendFormat": "breaker"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Fallback / stale / SSE / degraded",
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "prediction_fallback_active",
     "legendFormat": "fallback"
    },
    {
     "refId": "B",
     "expr": "sim_stale",
     "legendFormat": "stale"
    },
    {
     "refId": "C",
     "expr": "sse_connected",
     "legendFormat": "sse connected"
    },
    {
     "refId": "D",
     "expr": "platform_degraded",
     "legendFormat": "degraded"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Recommendations",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (increase(recommendations_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Decision cycle p95",
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(decision_cycle_seconds_bucket[1m])))",
     "legendFormat": "cycle p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Forecast MAPE per fuel",
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "prediction_forecast_mape",
     "legendFormat": "{{fuel}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "type": "timeseries",
   "title": "Station risk",
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "station_risk",
     "legendFormat": "{{station}} {{fuel}}"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ],
 "tags": [
  "fuel"
 ]
}